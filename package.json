{
	"name": "slackdesk",
	"version": "1.0.0",
	"description": "Slack Desktop Client with Blur Privacy Mode",
	"homepage": "https://github.com/slackdesk/slackdesk",
	"main": "main.js",
	"scripts": {
		"start": "electron main.js",
		"dev": "DEBUG=true npm start",
		"build": "node build.js",
		"tsc": "tsc --noEmit"
	},
	"keywords": [
		"Slack",
		"Privacy",
		"Electron"
	],
	"author": "Junaid Tariq <junaidtariqhere@gmail.com>",
	"license": "MIT",
	"dependencies": {
		"@types/node": "^18.11.0",
		"del": "^6.0.0",
		"electron-main-notification": "^1.0.1",
		"jquery": "^3.6.0",
		"semver": "^7.3.5",
		"ts-node": "^10.9.1",
		"typescript": "^4.9.4"
	},
	"devDependencies": {
		"electron": "^31.0.0",
		"electron-builder": "^23.6.0"
	},
	"build": {
		"appId": "com.slackdesk.privacy",
		"productName": "SlackDesk",
		"icon": "icon.png",
		"asar": true,
		"directories": {
			"output": "dist"
		},
		"files": [
			"**/*",
			"!dist/**/*",
			"!electron-build/**/*"
		],
		"linux": {
			"mimeTypes": [
				"x-scheme-handler/slack"
			],
			"category": "Network",
			"target": [
				"deb",
				"AppImage"
			]
		},
		"deb": {
			"priority": "optional",
			"compression": "gz",
			"maintainer": "Junaid Tariq <junaidtariqhere@gmail.com>"
		},
		"win": {
			"target": [
				"nsis"
			]
		}
	}
}